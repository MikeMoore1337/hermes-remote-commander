{
    "name":  "brc",
    "private":  true,
    "version":  "2.0.2",
    "description":  "Better Remote Commander (BRC) - self-hosted remote desktop agent + MCP relay for Claude and ChatGPT",
    "license":  "MIT",
    "packageManager":  "pnpm@11.24.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "scripts":  {
                    "build":  "pnpm -r --filter \"./packages/*\" build",
                    "clean":  "pnpm -r --filter \"./packages/*\" exec rimraf dist",
                    "typecheck":  "pnpm -r --filter \"./packages/*\" exec tsc --noEmit",
                    "agent":  "pnpm --filter brc-agent start",
                    "relay":  "pnpm --filter brc-relay start",
                    "dev:relay":  "pnpm --filter brc-relay build \u0026\u0026 node packages/relay/dist/cli.js",
                    "dev:agent":  "pnpm --filter brc-agent build \u0026\u0026 node packages/agent/dist/cli.js",
                    "extract-tools":  "node scripts/extract-tools.mjs",
                    "pack:all":  "pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../dist-pack",
                    "publish:all":  "pnpm -r --filter \"./packages/*\" publish --access public",
                    "test:unit":  "node --test packages/relay/test/unit.test.mjs",
                    "test:e2e":  "node scripts/e2e-all.mjs",
                    "test:hermes":  "node --test scripts/e2e-suite.test.mjs scripts/hermes-workspaces.test.mjs scripts/hermes-process.test.mjs && node scripts/hermes-agent-policy.mjs && node scripts/h15_brc_relay_ws_e2e.mjs && node scripts/h15_brc_two_wss_agents_e2e.mjs && node scripts/h15_brc_gateway_policy_e2e.mjs && node scripts/h15_brc_reconnect_socket_e2e.mjs && node scripts/h15_brc_browser_csrf_e2e.mjs && node scripts/hermes-revocation-e2e.mjs packages/agent",
                    "test":  "pnpm test:unit \u0026\u0026 pnpm test:e2e"
                },
    "devDependencies":  {
                            "@types/node":  "^24.0.0",
                            "rimraf":  "^6.0.1",
                            "typescript":  "^5.6.0"
                        }
}
